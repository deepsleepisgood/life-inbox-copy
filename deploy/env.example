# Life Inbox settings for a deployed server. Copy to .env (on the server, or into
# your host's "Variables"/"Secrets" screen) and fill in. Never commit the filled copy.

# --- required ---------------------------------------------------------------
LIFE_INBOX_ENV=beta
LIFE_INBOX_AUTH_MODE=password
LIFE_INBOX_TIMEZONE=Asia/Kolkata
# 32+ random characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LIFE_INBOX_OTP_PEPPER=
# On a PaaS, paste the Postgres URL it gives you, in this form:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (on the VPS compose file it's built from POSTGRES_PASSWORD; leave it empty there)
DATABASE_URL=
LIFE_INBOX_UPLOAD_DIR=/data/uploads

# --- VPS only (docker-compose.vps.yml) ---------------------------------------
POSTGRES_PASSWORD=
LIFE_INBOX_DOMAIN=inbox.example.com

# --- AI (leave empty to run with no AI at all) --------------------------------
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_ASR_MODEL=openai/whisper-large-v3
LIFE_INBOX_MEMORY_IN_FILING=0

# --- email: "off" for a private beta (reset passwords with the operator script),
# or "smtp" for real "Forgot password" emails (Gmail: an app password, port 587)
LIFE_INBOX_EMAIL_PROVIDER=off
LIFE_INBOX_SMTP_HOST=smtp.gmail.com
LIFE_INBOX_SMTP_PORT=587
LIFE_INBOX_SMTP_USER=
LIFE_INBOX_SMTP_PASSWORD=
LIFE_INBOX_SMTP_FROM=

# --- optional: push notifications (the key-making command is in docs/deployment.md, "Required environment variables")
LIFE_INBOX_VAPID_PUBLIC_KEY=
LIFE_INBOX_VAPID_PRIVATE_KEY=
LIFE_INBOX_VAPID_SUBJECT=mailto:you@example.com
